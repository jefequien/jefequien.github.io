{
  "name": "jefequien.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "Jeffrey Hu's personal academic website",
  "scripts": {
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "validate:html": "html-validate website/index.html",
    "validate:links": "node scripts/check-local-links.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run build:cv && npm run format:check && npm run validate:html && npm run validate:links && npm test",
    "build:cv": "bash scripts/build-cv.sh",
    "test:browser": "node --test scripts/browser.test.mjs"
  },
  "devDependencies": {
    "html-validate": "11.16.1",
    "playwright": "1.63.0",
    "prettier": "3.9.9"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "prettier": {
    "printWidth": 100,
    "proseWrap": "preserve",
    "tabWidth": 2,
    "useTabs": false
  }
}
